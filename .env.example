# GEMINI_API_KEY: Required for Gemini AI API calls and Assistant.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Project URL from your Supabase Dashboard
SUPABASE_URL="https://hhpuulthqvbjdwtcxftt.supabase.co"

# SUPABASE_ANON_KEY: Anonymous public API key for Supabase
SUPABASE_ANON_KEY="sb_publishable_3yHTGckkLEymuz4vCmFPBA_T3D0voh3"

# AGORA_APP_ID: Official App ID from Agora.io Console for Live Video Streaming and Realtime Calls
AGORA_APP_ID="bec7d2fdad814e3a86af74b08b8afdbc"

# OPENAI_API_KEY: Optional secondary AI provider API Key
OPENAI_API_KEY="your-openai-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

